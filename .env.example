# Backend
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
# cached is the safe demo default; set live to request FortyGuard at runtime.
FORTYGUARD_MODE=cached
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://heatshift-ai-zeta.vercel.app
FORTYGUARD_CREDIT_RESERVE=200000
FORTYGUARD_SITE_WEEK_ESTIMATE=64240

# Free hosted Responses provider for the zero-cost deployed demo.
# OmniRoute is supported only as a local test override: set provider=omniroute,
# base URL=http://localhost:20128/v1, and a model exposed by that runtime.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-27b
# Qwen 3.6 supports "none" for concise operational dialogue. Other models may
# support low/medium/high instead; use only a value documented by the provider.
LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=1536

# Durable anonymous workspaces. SUPABASE_SECRET_KEY accepts the current
# sb_secret_ key (preferred) or the legacy service_role key. Keep it server-side only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Live site-week provisioning only. The token is verified server-side.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1,heatshift-ai-zeta.vercel.app

# Local development adapter. Set false in every hosted environment.
HEATSHIFT_LOCAL_AUTH=true

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
